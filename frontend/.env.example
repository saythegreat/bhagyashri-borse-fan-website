# ========================================================
# A World of Bhagyashri - Frontend Configuration
# ========================================================

# In production (Vercel):
# Set BACKEND_API_URL to your deployed FastAPI backend URL:
# Example: BACKEND_API_URL=https://bhagya-backend.onrender.com/api
# This is used for server-side Next.js rewrites (/api/backend/*) and video streaming (/media/*).
BACKEND_API_URL=http://127.0.0.1:8000/api

# (Optional) If you want the browser to connect directly to the backend instead of proxying:
# Example: NEXT_PUBLIC_API_URL=https://bhagya-backend.onrender.com/api
# If omitted or left as /api/backend, Next.js safely proxies requests through Vercel.
NEXT_PUBLIC_API_URL=/api/backend

