# ========================================================
# A World of Bhagyashri - Frontend Configuration
# ========================================================

# In production on Vercel:
# Set BACKEND_API_URL to your deployed Vercel FastAPI backend URL:
# Example: BACKEND_API_URL=https://bhagya-backend.vercel.app/api
# This is used for server-side Next.js rewrites (/api/backend/*) and video streaming (/media/*).
BACKEND_API_URL=http://127.0.0.1:8000/api

# In production on Vercel:
# Set NEXT_PUBLIC_API_URL to your deployed Vercel FastAPI backend URL (or leave as /api/backend to proxy via Next.js):
# Example: NEXT_PUBLIC_API_URL=https://bhagya-backend.vercel.app/api
NEXT_PUBLIC_API_URL=/api/backend

