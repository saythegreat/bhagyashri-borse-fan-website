# ========================================================
# A World of Bhagyashri - Backend Configuration
# ========================================================

APP_NAME="A World of Bhagyashri - Fan API"
APP_ENV=development
DEBUG=true

# Database Connection
# In local development: sqlite:///./bhagyashri.db
# In production on Vercel: Neon PostgreSQL or Vercel Postgres connection URL
# Example: DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/bhagya_db?sslmode=require
DATABASE_URL=sqlite:///./bhagyashri.db

# Frontend Application Origin for CORS
# In production on Vercel: set to your deployed frontend domain
# Example: FRONTEND_ORIGIN=https://bhagyashri-borse-fan-website.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Media Storage Directory
MEDIA_STORAGE_DIR=./storage
THUMBNAIL_SIZE=500
MAX_DOWNLOAD_BYTES=15000000

# Authentication & Security
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (for first-time local setup)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=BhagyaAdmin@2025!

# Optional Discovery Providers
# 1. Wikimedia Commons (Default): Built-in, no API key needed!
# 2. Openverse (Creative Commons): Built-in, no API key needed!
# 3. Microsoft Azure Bing Image Search v7:
#    If you have an Azure cognitive services subscription, provide your key below.
#    Leave empty to use Wikimedia Commons and Openverse.
BING_IMAGE_SEARCH_API_KEY=
BING_IMAGE_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/images/search
